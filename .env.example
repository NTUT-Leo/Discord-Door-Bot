# Required. Create a new token in Discord Developer Portal; never commit it.
DISCORD_BOT_TOKEN=replace_with_your_bot_token
DISCORD_GUILD_ID=123456789012345678

# BCM GPIO numbering and the values used by the original installation.
SERVO_GPIO=14
SERVO_MIN_ANGLE=0
SERVO_MAX_ANGLE=90
SERVO_REST_ANGLE=0
SERVO_OPEN_ANGLE=37
SERVO_HOLD_SECONDS=0.5
SERVO_RETURN_SECONDS=0.5
